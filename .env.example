# Copie este arquivo para ".env" e ajuste os valores.
# O instalador (deploy/install.sh) gera este arquivo automaticamente.

FLASK_ENV=production
SECRET_KEY=troque-esta-chave-por-uma-aleatoria-e-secreta

# postgresql://usuario:senha@localhost:5432/nome_do_banco
DATABASE_URL=postgresql://bentao_user:troque-esta-senha@localhost:5432/bentao_db

UPLOAD_FOLDER=/opt/bentao-backend/app/static/uploads
SESSION_COOKIE_SECURE=true
PREFERRED_URL_SCHEME=https

PORT=8000
